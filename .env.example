# Copy this file to .env.local and fill in your values.
# Never put real credentials in this example file — .env.local is gitignored.

# --- TMDB -------------------------------------------------------------------
# Get a v3 API key from https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_v3_api_key_here

# Or, if you prefer a v4 read access token, use this instead of TMDB_API_KEY:
# TMDB_READ_ACCESS_TOKEN=your_tmdb_v4_read_access_token_here

# --- Screenscape ------------------------------------------------------------
# Movie embed URL. Available tokens:
#   {id}      - provider id (falls back to the TMDB id)
#   {tmdbId}  - TMDB id
#   {type}    - movie or tv
#   {title}   - URL-encoded title
# SCREENSCAPE_EMBED_TEMPLATE=https://web.screenscape.fun/embed?tmdb={tmdbId}&type=movie&lan=eng

# TV embed URL. Also supports {s} (season) and {e} (episode).
# SCREENSCAPE_TV_EMBED_TEMPLATE=https://web.screenscape.fun/embed?tmdb={tmdbId}&type=tv&s={s}&e={e}&lan=eng

# Per-title overrides can be added in js/screenscape-map.js

# --- Optional ---------------------------------------------------------------
# SITE_NAME=Toxibh Flix
# port=3000
# TMDB_BASE_URL=https://api.themoviedb.org/3/
